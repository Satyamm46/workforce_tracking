# ==========================================================
#  Java / Maven (backend)
# ==========================================================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled output
*.class

# Log files
logs/
*.log

# ==========================================================
#  Spring Boot — local secrets & overrides
# ==========================================================
# Never commit machine-specific or secret-bearing overrides.
# application.properties is the deployed base config: it holds NO real secrets
# (every credential is ${ENV_VAR:} with an empty/dev-only default) and MUST be
# committed so it ships in the jar. Real secrets are injected as env vars in
# production. Only the local dev file, which may hold real credentials, stays
# out of git.
application-dev.properties
application-local.properties
src/main/resources/application-dev.properties
*.env
.env

# ==========================================================
#  IDE — IntelliJ IDEA
# ==========================================================
.idea/
*.iml
*.iws
*.ipr

# ==========================================================
#  IDE — Eclipse / VS Code
# ==========================================================
.settings/
.project
.classpath
.vscode/
bin/

# ==========================================================
#  Node / React (frontend — added preemptively)
# ==========================================================
node_modules/
dist/
dist-ssr/
*.local
frontend/node_modules/
frontend/dist/

